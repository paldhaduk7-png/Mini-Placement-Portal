PORT=5000
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Note: Use the Supabase Connection Pooler URL above (not direct db.*.supabase.co) for IPv4 compatibility on Render.
# Note: If your password contains special characters like '@', '#', '%', URL-encode them (e.g. '@' becomes '%40')
JWT_SECRET="your_jwt_secret_key"

# Email / SMTP Configuration (Gmail SMTP)
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME="your-tpo-email@gmail.com"
MAIL_PASSWORD="your-16-char-google-app-password"
MAIL_FROM="your-tpo-email@gmail.com"
