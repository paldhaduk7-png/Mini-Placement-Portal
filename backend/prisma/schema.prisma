datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  STUDENT
  TPO
}

enum StudentType {
  REGULAR
  D2D
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DriveStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

// ==========================================
// USER (Authentication & Base Account)
// ==========================================

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  password         String
  role             Role               @default(STUDENT)
  name             String?
  phone            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  student          Student?
  createdDrives    RecruitmentDrive[]
  createdCompanies Company[]
}

// ==========================================
// STUDENT PROFILE
// ==========================================

model Student {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  fullName                String
  phone                   String
  dob                     DateTime
  studentType             StudentType        @default(REGULAR)
  department              String
  currentCgpa             Float
  activeBacklogs          Int                @default(0)
  totalBacklogs           Int                @default(0)
  profilePhoto            String?

  // Resume Details
  resumeUrl               String?
  resumeFileName          String?
  resumeUploadedAt        DateTime?

  // Std 10 Subject Marks Breakdown
  tenthMathsMarks         Float
  tenthScienceMarks       Float
  tenthEnglishMarks       Float
  tenthSocialScienceMarks  Float
  tenthLanguageMarks      Float?
  tenthTotalMarks         Float
  tenthMaxMarks           Float              @default(500)
  tenthPercentage         Float

  // Std 12 (Applicable only for REGULAR students)
  twelfthPercentage       Float?

  // D2D Academic Details (Applicable only for D2D students)
  d2dCgpa                 Float?
  diplomaBranch           String?
  diplomaCollege          String?

  // Profile Lock & TPO Verification Workflow
  isProfileLocked         Boolean            @default(false)
  verificationStatus      VerificationStatus @default(PENDING)
  verifiedAt              DateTime?
  rejectionReason         String?

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications            Application[]
}

// ==========================================
// COMPANY
// ==========================================

model Company {
  id          String             @id @default(uuid())
  name        String             @unique
  imageUrl    String?
  website     String?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  drives      RecruitmentDrive[]
}

// ==========================================
// RECRUITMENT DRIVE
// ==========================================

model RecruitmentDrive {
  id                   String        @id @default(uuid())
  companyId            String
  role                 String
  description          String?
  ctc                  Float         // CTC in LPA
  jobLocation          String?
  driveDate            DateTime
  deadline             DateTime
  status               DriveStatus   @default(UPCOMING)

  // Eligibility Criteria
  minCgpa              Float         @default(0.0)
  minTenthPercentage   Float         @default(0.0)
  minTwelfthPercentage Float?        // Evaluated for REGULAR students
  minD2dCgpa           Float?        // Evaluated for D2D students
  maxActiveBacklogs    Int           @default(0)
  allowedStudentTypes  StudentType[] @default([REGULAR, D2D])
  allowedDepartments   String[]      @default([])
  requiresVerification Boolean       @default(true) // Requires TPO verification = VERIFIED

  createdById          String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy            User          @relation(fields: [createdById], references: [id])
  applications         Application[]
}

// ==========================================
// APPLICATION (Student <-> Drive)
// ==========================================

model Application {
  id             String            @id @default(uuid())
  studentId      String
  driveId        String
  appliedAt      DateTime          @default(now())
  status         ApplicationStatus @default(APPLIED)
  remarks        String?
  updatedAt      DateTime          @updatedAt

  // Resume attached to this specific application
  resumeUrl      String?
  resumeFileName String?
  resumePath     String?

  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive          RecruitmentDrive  @relation(fields: [driveId], references: [id], onDelete: Cascade)

  // Prevents duplicate applications
  @@unique([studentId, driveId])

  isCurrentPlacement Boolean @default(false)
  interviews         Interview[]
}

// ==========================================
// INTERVIEW SCHEDULE
// ==========================================

model Interview {
  id              String      @id @default(uuid())
  applicationId   String
  interviewDate   DateTime
  interviewTime   String
  round           String
  mode            String      // e.g., "ONLINE" or "OFFLINE"
  meetingLink     String?
  location        String?
  instructions    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
